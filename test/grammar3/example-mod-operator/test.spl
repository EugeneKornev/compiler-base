extern def putchar(x);

def printInt(n) {
    if (n < 0) {
        putchar(45);
        printInt(-n);
    } else {
        if (n >= 10) {
            printInt(n / 10);
        }
        putchar(48 + n % 10);
    }
    return 0;
}

def main() {
    printInt(12345 % 100);
    putchar(10);
    printInt(-17 % 5);
    putchar(10);
    return 0;
}
