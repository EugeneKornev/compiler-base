extern def putchar(x);

def printInt(n) {
    if (n < 0) {
        putchar(45);
        printInt(-n);
    } else {
        if (n >= 10) {
            printInt(n / 10);
        }
        putchar(48 + n % 10);
    }
    return 0;
}

def printBin(n) {
    if (n >= 2) {
        printBin(n / 2);
    }
    putchar(48 + n % 2);
    return 0;
}

def main() {
    printBin(156);
    putchar(10);
    return 0;
}
