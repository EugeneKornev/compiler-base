extern def putchar(x);

def printInt(n) {
    if (n < 0) {
        putchar(45);
        printInt(-n);
    } else {
        if (n >= 10) {
            printInt(n / 10);
        }
        putchar(48 + n % 10);
    }
    return 0;
}

def digitSum(n) {
    var s = 0;
    var v = n;
    while (v > 0) {
        s = s + v % 10;
        v = v / 10;
    }
    return s;
}

def main() {
    printInt(digitSum(12345));
    putchar(10);
    return 0;
}
