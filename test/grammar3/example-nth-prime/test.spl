extern def putchar(x);

def printInt(n) {
    if (n < 0) {
        putchar(45);
        printInt(-n);
    } else {
        if (n >= 10) {
            printInt(n / 10);
        }
        putchar(48 + n % 10);
    }
    return 0;
}

def isPrime(n) {
    if (n < 2) {
        return 0;
    }
    var i = 2;
    while (i * i <= n) {
        if (n % i == 0) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

def main() {
    var count = 0;
    var n = 1;
    while (count < 10) {
        n = n + 1;
        if (isPrime(n)) {
            count = count + 1;
        }
    }
    printInt(n);
    putchar(10);
    return 0;
}
