extern def putchar(x);

def printInt(n) {
    if (n < 0) {
        putchar(45);
        printInt(-n);
    } else {
        if (n >= 10) {
            printInt(n / 10);
        }
        putchar(48 + n % 10);
    }
    return 0;
}

def popcount(n) {
    var c = 0;
    var v = n;
    while (v > 0) {
        if (v % 2 == 1) {
            c = c + 1;
        }
        v = v / 2;
    }
    return c;
}

def main() {
    printInt(popcount(255));
    putchar(10);
    return 0;
}
